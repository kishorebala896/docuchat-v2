# --- answering model: gpt4o | gpt4o-mini (default) | opus | ollama ---
LLM_PROVIDER=gpt4o-mini
OPENAI_API_KEY=<redacted>

# --- opus baseline (eval harness + optional answering) ---
# ANTHROPIC_API_KEY=<redacted>

# --- local answering via ollama (ollama serve + ollama pull llama3.1:8b) ---
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

# --- embeddings: local (default, free, offline) or openai ---
EMBEDDING_PROVIDER=local
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- parsing: layout (default, pymupdf4llm) ---
# PARSER=layout

# --- retrieval tuning ---
# RETRIEVAL_DISTANCE_THRESHOLD=0.9
# USE_RERANKER=false

# --- ingestion: false = in-process background tasks (demo), true = celery ---
# USE_CELERY=false
# CELERY_BROKER=redis://localhost:6379/0

# --- storage ---
# DATABASE_URL=<redacted>
# DATA_DIR=data
